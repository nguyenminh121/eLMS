# Copy to .env and fill in. .env is gitignored.
# ASP.NET Core maps double underscores to nested config:
#   ConnectionStrings__DefaultConnection -> ConnectionStrings:DefaultConnection

# --- SQL Server ---
# Production: hostname of the existing SQL Server container on Docker network sqlserver-network.
# Local dotnet run does not use MSSQL_HOST; it uses the connection string below.
MSSQL_HOST=sqlserver
MSSQL_SA_PASSWORD=ChangeMe_Sa_2026!
MSSQL_APP_PASSWORD=ChangeMe_App_2026!
MSSQL_DATABASE=BasicLMS

# Local `dotnet run` (SQL published on the host). Password must equal MSSQL_APP_PASSWORD.
ConnectionStrings__DefaultConnection=Server=127.0.0.1,1433;Database=BasicLMS;User Id=lms_app;Password=ChangeMe_App_2026!;TrustServerCertificate=True;Connect Timeout=10;

# --- JWT (HS256, key must be at least 32 bytes) ---
Jwt__Key=replace-this-with-a-random-string-of-32-bytes-min
Jwt__Issuer=BasicLMS
Jwt__Audience=BasicLMS.Client
Jwt__ExpireMinutes=60

# Required on the Linux server (Production). Locally, empty falls back to
# admin@basiclms.local / Admin@123456.
# Must match Identity policy: >=6 chars, upper, lower, digit, special (!@#...).
Seed__AdminEmail=admin@basiclms.local
Seed__AdminPassword=ChangeMe_Admin_2026!

# Uploaded course files (relative to API content root unless absolute).
Storage__Root=uploads
